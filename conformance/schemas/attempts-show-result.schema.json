{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/conformance/schemas/attempts-show-result.schema.json",
  "title": "agentctl attempts show result",
  "description": "An attempt summary plus the manifest computed on read ({path, kind, media_type, size, sha256} per entry).",
  "type": "object",
  "required": ["attempt", "manifest"],
  "properties": {
    "attempt": {"type": "object"},
    "manifest": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "kind", "media_type", "size", "sha256"],
        "properties": {
          "path": {"type": "string"},
          "kind": {"enum": ["transcript", "command_output", "record", "other"]},
          "media_type": {"type": "string"},
          "size": {"type": "integer"},
          "sha256": {"type": "string"}
        }
      }
    }
  }
}
