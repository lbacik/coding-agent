{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/conformance/schemas/envelope.schema.json",
  "title": "agentctl envelope",
  "description": "The one JSON envelope agentctl prints on stdout: contract 1.0, ok, and exactly one of result or error. Mirrors the examples/agentctl fixtures at pinned revision 06ee46c.",
  "type": "object",
  "required": ["contract", "ok"],
  "properties": {
    "contract": {"const": "1.0"},
    "ok": {"type": "boolean"},
    "result": {"type": "object"},
    "error": {
      "type": "object",
      "required": ["code", "message", "retryable"],
      "properties": {
        "code": {
          "enum": [
            "rejected",
            "repository_mismatch",
            "payload_mismatch",
            "invalid_argument",
            "usage",
            "unsupported",
            "contract_mismatch",
            "not_found",
            "agent_unreachable",
            "internal"
          ]
        },
        "message": {"type": "string"},
        "retryable": {"type": "boolean"},
        "request_id": {"type": "string"},
        "details": {"type": "object"}
      }
    }
  }
}
