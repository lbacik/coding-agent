+
+
+def test_receipt_total_applies_percentage_discount() -> None:
+    lines = [(Decimal("2.50"), 3), (Decimal("1.05"), 2)]
+    assert receipt_total(lines, 10) == Decimal("8.64")
+
+
+def test_receipt_total_rejects_negative_discount() -> None:
+    lines = [(Decimal("2.50"), 3)]
+    with pytest.raises(ValueError, match="discount_percent"):
+        receipt_total(lines, -1)
+
+
+def test_receipt_total_rejects_discount_above_one_hundred() -> None:
+    lines = [(Decimal("2.50"), 3)]
+    with pytest.raises(ValueError, match="discount_percent"):
+        receipt_total(lines, 101)
+
+
+def test_receipt_total_allows_full_discount() -> None:
+    lines = [(Decimal("2.50"), 3)]
+    assert receipt_total(lines, 100) == Decimal("0.00")
+
+
+def test_receipt_total_rejects_fractional_discount() -> None:
+    lines = [(Decimal("2.50"), 3)]
+    with pytest.raises(ValueError, match="discount_percent"):
+        receipt_total(lines, 10.5)  # type: ignore[arg-type]
+
+
+def test_receipt_total_rounds_half_cent_up() -> None:
+    # 10.05 less 50% is exactly 5.025; half away from zero gives 5.03.
+    lines = [(Decimal("10.05"), 1)]
+    assert receipt_total(lines, 50) == Decimal("5.03")
