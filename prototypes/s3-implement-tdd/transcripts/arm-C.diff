-def receipt_total(lines: list[tuple[Decimal, int]]) -> Decimal:
-    """The sum of every line on the receipt."""
+def receipt_total(
+    lines: list[tuple[Decimal, int]], discount_percent: int = 0
+) -> Decimal:
+    """The sum of every line on the receipt, less a percentage discount.
+
+    ``discount_percent`` is a whole number of percent between 0 and 100
+    inclusive, applied to the summed total of the lines.
+    """
+    if not isinstance(discount_percent, int):
+        raise ValueError(
+            "discount_percent must be a whole number, not "
+            f"{type(discount_percent).__name__}"
+        )
+    if not 0 <= discount_percent <= 100:
+        raise ValueError("discount_percent must be between 0 and 100 inclusive")
     total = Decimal("0")
     for unit_price, quantity in lines:
         total += line_total(unit_price, quantity)
-    return to_cents(total)
+    retained_percent = Decimal(100 - discount_percent)
+    return to_cents(total * retained_percent / Decimal(100))
 
 
