diff --git a/tests/test_receipts.py b/tests/test_receipts.py
index b090aaa..c91f8f8 100644
--- a/tests/test_receipts.py
+++ b/tests/test_receipts.py
@@ -17,3 +17,42 @@ def test_line_total_rejects_negative_quantity() -> None:
 def test_receipt_total_sums_lines() -> None:
     lines = [(Decimal("2.50"), 3), (Decimal("1.05"), 2)]
     assert receipt_total(lines) == Decimal("9.60")
+
+
+def test_receipt_total_applies_discount_percent() -> None:
+    lines = [(Decimal("2.50"), 3), (Decimal("1.05"), 2)]
+    assert receipt_total(lines, 10) == Decimal("8.64")
+
+
+def test_receipt_total_rounds_discounted_total_half_up() -> None:
+    # 10.05 less 10% is exactly 9.045, which rounds away from zero to 9.05.
+    lines = [(Decimal("3.35"), 3)]
+    assert receipt_total(lines, 10) == Decimal("9.05")
+
+
+def test_receipt_total_accepts_a_zero_discount() -> None:
+    lines = [(Decimal("2.50"), 3), (Decimal("1.05"), 2)]
+    assert receipt_total(lines, 0) == Decimal("9.60")
+
+
+def test_receipt_total_accepts_a_full_discount() -> None:
+    lines = [(Decimal("2.50"), 3), (Decimal("1.05"), 2)]
+    assert receipt_total(lines, 100) == Decimal("0.00")
+
+
+@pytest.mark.parametrize("discount_percent", [-1, 101])
+def test_receipt_total_rejects_discount_percent_outside_range(
+    discount_percent: int,
+) -> None:
+    lines = [(Decimal("2.50"), 3)]
+    with pytest.raises(ValueError, match="discount_percent"):
+        receipt_total(lines, discount_percent)
+
+
+@pytest.mark.parametrize("discount_percent", [10.5, Decimal("10.5"), "10"])
+def test_receipt_total_rejects_discount_percent_that_is_not_a_whole_number(
+    discount_percent: object,
+) -> None:
+    lines = [(Decimal("2.50"), 3)]
+    with pytest.raises(ValueError, match="discount_percent"):
+        receipt_total(lines, discount_percent)  # type: ignore[arg-type]
