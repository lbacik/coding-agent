--- a/tests/test_receipts.py
+++ b/tests/test_receipts.py
@@ -17,3 +17,37 @@ def test_line_total_rejects_negative_quantity() -> None:
 def test_receipt_total_sums_lines() -> None:
     lines = [(Decimal("2.50"), 3), (Decimal("1.05"), 2)]
     assert receipt_total(lines) == Decimal("9.60")
+
+
+def test_receipt_total_applies_discount_percent() -> None:
+    lines = [(Decimal("2.50"), 3), (Decimal("1.05"), 2)]
+    # 9.60 less 15% is 8.16
+    assert receipt_total(lines, 15) == Decimal("8.16")
+
+
+def test_receipt_total_rounds_discounted_total_half_up() -> None:
+    lines = [(Decimal("0.13"), 1)]
+    # 0.13 less 50% is 0.065, which rounds half away from zero to 0.07
+    assert receipt_total(lines, 50) == Decimal("0.07")
+
+
+def test_receipt_total_accepts_the_ends_of_the_discount_range() -> None:
+    lines = [(Decimal("2.50"), 3), (Decimal("1.05"), 2)]
+    assert receipt_total(lines, 0) == Decimal("9.60")
+    assert receipt_total(lines, 100) == Decimal("0.00")
+
+
+@pytest.mark.parametrize("discount_percent", [-1, 101])
+def test_receipt_total_rejects_discount_outside_range(discount_percent: int) -> None:
+    lines = [(Decimal("2.50"), 3)]
+    with pytest.raises(ValueError, match="discount_percent"):
+        receipt_total(lines, discount_percent)
+
+
+@pytest.mark.parametrize("discount_percent", [12.5, Decimal("12.5"), 15.0])
+def test_receipt_total_rejects_discount_that_is_not_a_whole_number(
+    discount_percent: object,
+) -> None:
+    lines = [(Decimal("2.50"), 3)]
+    with pytest.raises(ValueError, match="discount_percent"):
+        receipt_total(lines, discount_percent)  # type: ignore[arg-type]
