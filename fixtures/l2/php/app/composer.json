{
    "name": "coding-agent/l2-fixture-php",
    "description": "L2 fixture (issue #18): a real, minimal PHP/composer/PHPUnit project, bootstrapped and validated inside the image.",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.4"
    },
    "require-dev": {
        "phpunit/phpunit": "11.5.56"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    }
}
